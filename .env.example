# =============================================================================
# Tess — plantilla de variables de entorno
# Copia a `.env` y rellena. `.env` NUNCA se commitea.
#
# Regla de oro: todo lo que empiece por PUBLIC_ termina en el bundle del
# navegador. Cualquier otra variable de este archivo debe existir únicamente
# en el servidor (Cloud Run, Vercel Environment Variables o el gestor de
# secretos correspondiente).
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
NODE_ENV=development
# Identificador de release para Sentry y trazabilidad. En CI: el SHA del commit.
APP_RELEASE=tess@0.0.0-dev

# -----------------------------------------------------------------------------
# Supabase — proyecto `tess` (ref mpntdrcsdspuyfltvexs, us-west-2, PG 17)
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=mpntdrcsdspuyfltvexs
SUPABASE_URL=https://mpntdrcsdspuyfltvexs.supabase.co
SUPABASE_ANON_KEY=
# SOLO servidor. Bypasea RLS. Jamás en apps/*, packages/* ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de la base para `supabase link` / `supabase db push`.
# Preferible exportarla en la shell en lugar de escribirla aquí.
SUPABASE_DB_PASSWORD=

# Para desarrollo con base local (`supabase start`), apunta SUPABASE_URL y
# PUBLIC_SUPABASE_URL a http://127.0.0.1:54321 y usa las claves que imprime el
# CLI. Conexión directa a la base local:
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Espejo público para SvelteKit (solo URL y anon key, nunca service role).
PUBLIC_SUPABASE_URL=https://mpntdrcsdspuyfltvexs.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API de Tess
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Lo único que el navegador necesita saber del backend.
PUBLIC_TESS_API_URL=http://localhost:8080
# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Sentry
# Proyecto `tess-frontend` (Svelte/SvelteKit) -> demo, admin, web component, rive
# Proyecto `tess-api`      (Node.js)          -> services/api y workers
# -----------------------------------------------------------------------------
SENTRY_ORG=teams4soft

# --- Frontend (tess-frontend). El DSN de navegador es público por diseño. ---
SENTRY_PROJECT_FRONTEND=tess-frontend
PUBLIC_SENTRY_DSN=https://eaba3f06f6275bac50712f17666d9194@o4512008851488768.ingest.de.sentry.io/4512111214592080

# --- Backend (tess-api) ---
SENTRY_PROJECT_API=tess-api
SENTRY_DSN=https://c3a8860d785a9a2aab70d2a24f49ede3@o4512008851488768.ingest.de.sentry.io/4512111228551248

# development | staging | production
SENTRY_ENVIRONMENT=development
# Muestreo de trazas. Subir en dev, bajar en producción según volumen y coste.
SENTRY_TRACES_SAMPLE_RATE=1.0
# Token de organización para subir source maps durante el build. SOLO en CI.
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Proveedor de modelo y embeddings (Fase 3+)
# -----------------------------------------------------------------------------
# OpenRouter: una sola credencial para chat y embeddings, llamada por REST.
# `fake` es el valor obligatorio en CI: no llama a la red.
MODEL_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Credencial única de OpenRouter. SOLO servidor, nunca en el bundle.
OPENROUTER_API_KEY=
# Fijar a versión explícita, nunca a un alias: un alias puede cambiar de
# comportamiento sin un despliegue nuestro.
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Atribución opcional en el panel de OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Tess
# Sin este valor, OpenRouter reserva 65536 tokens para la respuesta, y una
# clave con límite de gasto rechaza la petición entera.
OPENROUTER_MAX_TOKENS=1024

# RAG. EMBEDDING_DIMENSIONS debe coincidir con la columna vector(1536).
EMBEDDING_DIMENSIONS=1536
RAG_MATCH_COUNT=8
RAG_SIMILARITY_THRESHOLD=0.5

# Documentos
DOCUMENTS_BUCKET=tess-documents
DOCUMENT_MAX_BYTES=26214400

# Rate limit de mensajes
MESSAGE_LIMIT=30
MESSAGE_WINDOW_SECONDS=300

# Worker de ingestión
INGEST_POLL_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# MCP y conectores (Fase 4+)
# -----------------------------------------------------------------------------
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
# Clave simétrica para cifrar credenciales de conectores en reposo (32 bytes base64).
CONNECTOR_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Cloud Run (Fase 5)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-west1
