{
  "name": "@teams4soft/tess-web-component",
  "version": "0.0.0",
  "description": "Elemento personalizado <teams4soft-assistant>.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tess.js": "./dist/tess.global.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@teams4soft/tess-client": "workspace:*",
    "@teams4soft/tess-core": "workspace:*",
    "@teams4soft/tess-rive": "workspace:*",
    "@teams4soft/tess-types": "workspace:*"
  },
  "devDependencies": {
    "@teams4soft/config-eslint": "workspace:*",
    "@teams4soft/config-tsconfig": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./dist/tess.global.js",
  "jsdelivr": "./dist/tess.global.js"
}
