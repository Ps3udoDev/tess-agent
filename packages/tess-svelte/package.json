{
  "name": "@teams4soft/tess-svelte",
  "version": "0.0.0",
  "description": "Wrapper Svelte del Web Component de Tess.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "dev": "svelte-package --input src --output dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@teams4soft/tess-core": "workspace:*",
    "@teams4soft/tess-types": "workspace:*",
    "@teams4soft/tess-web-component": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@teams4soft/config-eslint": "workspace:*",
    "@teams4soft/config-tsconfig": "workspace:*",
    "eslint": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
